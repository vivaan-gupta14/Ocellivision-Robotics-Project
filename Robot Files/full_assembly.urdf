<?xml version="1.0" encoding="utf-8"?>
<!-- Combined URDF: SO-101 arm (gripper + wrist_roll removed) + Prismatic
     Joint Carriage, merged into one kinematic tree so both can be driven
     together in a single viewer/session.

     SO-101 portion adapted from "so101_new_calib.urdf" (originally
     generated via onshape-to-robot). gripper_link, moving_jaw link, the
     wrist_roll and gripper joints, and their transmissions have been
     removed - the physical build replaces that hardware with a fixed
     mechanical mount straight onto wrist_link.

     Prismatic Joint Carriage portion adapted from the standalone
     prismatic_carriage.urdf. The wrist_to_rail joint below uses the
     transform computed from the "SO101 + Prismatic Carriage + Da Vinci"
     Fusion assembly (rail_link located relative to wrist_link's frame via
     the known Wrist_Roll_Pitch_SO100 mesh offset baked into the original
     SO-101 URDF). See prismatic_carriage.urdf's own header comments for
     the derivation and its stated assumption (component-local origin of
     the Fusion wrist part coincides with the source STL's local origin -
     user-confirmed, not independently verified).

     Mesh assets: all meshes (SO-101 parts + rail_link.stl + carriage_link.stl)
     are expected in a single shared "assets/" folder next to this file -
     filenames don't collide between the two sources.

     Units: meters throughout. -->
<robot name="so101_carriage_combined">

  <!-- Materials -->
  <material name="3d_printed">
    <color rgba="1.0 0.82 0.12 1.0"/>
  </material>
  <material name="sts3215">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <!-- ================================ SO-101 ARM ============================ -->

  <!-- Link base -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.0137179 -5.19711e-05 0.0334843" rpy="0 0 0"/>
      <mass value="0.147"/>
      <inertia ixx="0.000114686" ixy="-4.59787e-07" ixz="4.97151e-06" iyy="0.000136117" iyz="9.75275e-08" izz="0.000130364"/>
    </inertial>
    <visual>
      <origin xyz="-0.00636471 -9.94414e-05 -0.0024" rpy="1.5708 -1.67685e-15 1.5708"/>
      <geometry>
        <mesh filename="assets/base_motor_holder_so101_v1.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin xyz="-0.00636471 -9.94414e-05 -0.0024" rpy="1.5708 -1.67685e-15 1.5708"/>
      <geometry>
        <mesh filename="assets/base_motor_holder_so101_v1.stl"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="-0.00636471 -8.97657e-09 -0.0024" rpy="1.5708 -2.78073e-29 1.5708"/>
      <geometry>
        <mesh filename="assets/base_so101_v2.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin xyz="-0.00636471 -8.97657e-09 -0.0024" rpy="1.5708 -2.78073e-29 1.5708"/>
      <geometry>
        <mesh filename="assets/base_so101_v2.stl"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0.0263353 -8.97657e-09 0.0437" rpy="-8.21148e-16 7.84513e-18 1.249e-15"/>
      <geometry>
        <mesh filename="assets/sts3215_03a_v1.stl"/>
      </geometry>
      <material name="sts3215"/>
    </visual>
    <collision>
      <origin xyz="0.0263353 -8.97657e-09 0.0437" rpy="-8.21148e-16 7.84513e-18 1.249e-15"/>
      <geometry>
        <mesh filename="assets/sts3215_03a_v1.stl"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="-0.0309827 -0.000199441 0.0474" rpy="1.5708 -1.35493e-14 1.5708"/>
      <geometry>
        <mesh filename="assets/waveshare_mounting_plate_so101_v2.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin xyz="-0.0309827 -0.000199441 0.0474" rpy="1.5708 -1.35493e-14 1.5708"/>
      <geometry>
        <mesh filename="assets/waveshare_mounting_plate_so101_v2.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Link shoulder -->
  <link name="shoulder_link">
    <inertial>
      <origin xyz="-0.0307604 -1.66727e-05 -0.0252713" rpy="0 0 0"/>
      <mass value="0.100006"/>
      <inertia ixx="8.3759e-05" ixy="7.55525e-08" ixz="-1.16342e-06" iyy="8.10403e-05" iyz="1.54663e-07" izz="2.39783e-05"/>
    </inertial>
    <visual>
      <origin xyz="-0.0303992 0.000422241 -0.0417" rpy="1.5708 1.5708 0"/>
      <geometry>
        <mesh filename="assets/sts3215_03a_v1.stl"/>
      </geometry>
      <material name="sts3215"/>
    </visual>
    <collision>
      <origin xyz="-0.0303992 0.000422241 -0.0417" rpy="1.5708 1.5708 0"/>
      <geometry>
        <mesh filename="assets/sts3215_03a_v1.stl"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="-0.0675992 -0.000177759 0.0158499" rpy="1.5708 -1.5708 0"/>
      <geometry>
        <mesh filename="assets/motor_holder_so101_base_v1.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin xyz="-0.0675992 -0.000177759 0.0158499" rpy="1.5708 -1.5708 0"/>
      <geometry>
        <mesh filename="assets/motor_holder_so101_base_v1.stl"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0.0122008 2.22413e-05 0.0464" rpy="-1.5708 2.35221e-33 0"/>
      <geometry>
        <mesh filename="assets/rotation_pitch_so101_v1.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin xyz="0.0122008 2.22413e-05 0.0464" rpy="-1.5708 2.35221e-33 0"/>
      <geometry>
        <mesh filename="assets/rotation_pitch_so101_v1.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Link upper_arm -->
  <link name="upper_arm_link">
    <inertial>
      <origin xyz="-0.0898471 -0.00838224 0.0184089" rpy="0 0 0"/>
      <mass value="0.103"/>
      <inertia ixx="4.08002e-05" ixy="-1.97819e-05" ixz="-4.03016e-08" iyy="0.000147318" iyz="8.97326e-09" izz="0.000142487"/>
    </inertial>
    <visual>
      <origin xyz="-0.11257 -0.0155 0.0187" rpy="-3.14159 -5.27356e-16 -1.5708"/>
      <geometry>
        <mesh filename="assets/sts3215_03a_v1.stl"/>
      </geometry>
      <material name="sts3215"/>
    </visual>
    <collision>
      <origin xyz="-0.11257 -0.0155 0.0187" rpy="-3.14159 -5.27356e-16 -1.5708"/>
      <geometry>
        <mesh filename="assets/sts3215_03a_v1.stl"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="-0.065085 0.012 0.0182" rpy="3.14159 -0 -1.30911e-30"/>
      <geometry>
        <mesh filename="assets/upper_arm_so101_v1.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin xyz="-0.065085 0.012 0.0182" rpy="3.14159 -0 -1.30911e-30"/>
      <geometry>
        <mesh filename="assets/upper_arm_so101_v1.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Link lower_arm -->
  <link name="lower_arm_link">
    <inertial>
      <origin xyz="-0.0980701 0.00324376 0.0182831" rpy="0 0 0"/>
      <mass value="0.104"/>
      <inertia ixx="2.87438e-05" ixy="7.41152e-06" ixz="1.26409e-06" iyy="0.000159844" iyz="-4.90188e-08" izz="0.00014529"/>
    </inertial>
    <visual>
      <origin xyz="-0.0648499 -0.032 0.0182" rpy="3.14159 -0 6.67202e-31"/>
      <geometry>
        <mesh filename="assets/under_arm_so101_v1.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin xyz="-0.0648499 -0.032 0.0182" rpy="3.14159 -0 6.67202e-31"/>
      <geometry>
        <mesh filename="assets/under_arm_so101_v1.stl"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="-0.0648499 -0.032 0.018" rpy="-3.14159 -2.55351e-15 -1.83387e-30"/>
      <geometry>
        <mesh filename="assets/motor_holder_so101_wrist_v1.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin xyz="-0.0648499 -0.032 0.018" rpy="-3.14159 -2.55351e-15 -1.83387e-30"/>
      <geometry>
        <mesh filename="assets/motor_holder_so101_wrist_v1.stl"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="-0.1224 0.0052 0.0187" rpy="-3.14159 -7.88861e-31 -3.14159"/>
      <geometry>
        <mesh filename="assets/sts3215_03a_v1.stl"/>
      </geometry>
      <material name="sts3215"/>
    </visual>
    <collision>
      <origin xyz="-0.1224 0.0052 0.0187" rpy="-3.14159 -7.88861e-31 -3.14159"/>
      <geometry>
        <mesh filename="assets/sts3215_03a_v1.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Link wrist (terminal SO-101 link before the custom mount - the
       gripper claw mechanism is physically removed, but wrist_roll itself
       survives as the revolute connection straight into rail_link below,
       rather than as a separate link/joint pair) -->
  <link name="wrist_link">
    <inertial>
      <origin xyz="-0.000103312 -0.0386143 0.0281156" rpy="0 0 0"/>
      <mass value="0.079"/>
      <inertia ixx="3.68263e-05" ixy="1.7893e-08" ixz="-5.28128e-08" iyy="2.5391e-05" iyz="3.6412e-06" izz="2.1e-05"/>
    </inertial>
    <visual>
      <origin xyz="8.32667e-17 -0.0424 0.0306" rpy="1.5708 1.5708 0"/>
      <geometry>
        <mesh filename="assets/sts3215_03a_no_horn_v1.stl"/>
      </geometry>
      <material name="sts3215"/>
    </visual>
    <collision>
      <origin xyz="8.32667e-17 -0.0424 0.0306" rpy="1.5708 1.5708 0"/>
      <geometry>
        <mesh filename="assets/sts3215_03a_no_horn_v1.stl"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 -0.028 0.0181" rpy="-1.5708 -1.5708 0"/>
      <geometry>
        <mesh filename="assets/wrist_roll_pitch_so101_v2.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin xyz="0 -0.028 0.0181" rpy="-1.5708 -1.5708 0"/>
      <geometry>
        <mesh filename="assets/wrist_roll_pitch_so101_v2.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint from lower_arm to wrist -->
  <joint name="wrist_flex" type="revolute">
    <origin xyz="-0.1349 0.0052 3.62355e-17" rpy="4.02456e-15 8.67362e-16 -1.5708"/>
    <parent link="lower_arm_link"/>
    <child link="wrist_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.8596483" upper="1.65806"/>
  </joint>

  <transmission name="wrist_flex_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="wrist_flex">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="motor4">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- Joint from upper_arm to lower_arm -->
  <joint name="elbow_flex" type="revolute">
    <origin xyz="-0.11257 -0.028 1.73763e-16" rpy="-3.63608e-16 8.74301e-16 1.5708"/>
    <parent link="upper_arm_link"/>
    <child link="lower_arm_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.69" upper="1.6908750"/>
  </joint>

  <transmission name="elbow_flex_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="elbow_flex">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="motor3">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- Joint from shoulder to upper_arm -->
  <joint name="shoulder_lift" type="revolute">
    <origin xyz="-0.0303992 -0.0182778 -0.0542" rpy="-1.5708 -1.5708 0"/>
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.8205529" upper="1.74533"/>
  </joint>

  <transmission name="shoulder_lift_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="shoulder_lift">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="motor2">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- Joint from base to shoulder -->
  <joint name="shoulder_pan" type="revolute">
    <origin xyz="0.0388353 -8.97657e-09 0.0624" rpy="3.14159 4.18253e-17 -3.14159"/>
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.91986" upper="1.91986"/>
  </joint>

  <transmission name="shoulder_pan_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="shoulder_pan">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="motor1">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- ========================= PRISMATIC JOINT CARRIAGE ====================== -->
  <!-- Source: Fusion 360 "Prismatic Joint Carriage" file (no Fusion joints
       defined there - structure derived manually). Units converted from
       Fusion's internal cm to meters (x0.01). -->

  <link name="rail_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="assets/rail_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="assets/rail_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <!-- TODO: placeholder mass/inertia -->
      <mass value="0.15"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <!-- Mount point onto rail_link, now revolute (wrist_roll) instead of
       fixed - axis and limits carried over from the reference SO-101
       URDF's wrist_roll joint. Origin is the SAME measured transform as
       before (computed relative to wrist_link, unchanged) - nothing about
       rail_link's position/orientation moved, only the joint type and
       axis/limit were added. -->
  <!-- Dummy pivot link - exists only so the revolute rotation happens at
       the real measured wrist_roll shaft location, without disturbing
       rail_link's own mesh origin (which must stay untouched at "0 0 0"
       to preserve its correct relative alignment with carriage_link's
       mesh - both were exported from the same Fusion file sharing one
       coordinate system, and recentering just one of them breaks that
       alignment, which is exactly what went wrong on the previous
       attempt). -->
  <link name="wrist_roll_pivot_link"/>

  <joint name="wrist_to_rail" type="revolute">
    <parent link="wrist_link"/>
    <child link="wrist_roll_pivot_link"/>
    <origin xyz="-0.000001 -0.061549 0.019627" rpy="1.570643 0.017449 -0.008808"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.25" upper="1.25"/>
  </joint>

  <!-- Fixed offset from the pivot back to rail_link's own untouched
       origin - the negative of the same measured offset used above, with
       no additional rotation (the revolute joint above already carries
       the correct orientation). -->
  <joint name="pivot_to_rail" type="fixed">
    <parent link="wrist_roll_pivot_link"/>
    <child link="rail_link"/>
    <origin xyz="-0.209618 0 0.061592" rpy="0 0 0"/>
  </joint>

  <transmission name="wrist_to_rail_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="wrist_to_rail">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="motor5">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <link name="carriage_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="assets/carriage_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="assets/carriage_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <!-- TODO: placeholder mass/inertia -->
      <mass value="0.25"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
  </link>

  <!-- Prismatic joint - axis confirmed from cylindrical rod faces: world
       direction (1,0,0) in the standalone carriage file's own frame.
       Limits are travel relative to that file's as-drawn position, not a
       true zero/home. -->
  <joint name="carriage_prismatic_joint" type="prismatic">
    <parent link="rail_link"/>
    <child link="carriage_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.0625" upper="0.1131" effort="50" velocity="0.05"/>
  </joint>

  <transmission name="carriage_prismatic_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="carriage_prismatic_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="motor_carriage">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- ========================= DA VINCI INSTRUMENT ============================ -->
  <!-- Source: large_needle_driver_420006 (dVRK), mesh paths rewritten to the
       flat assets/ convention, wrist_yaw demoted from revolute to fixed and
       jaw_1/jaw_2 promoted from mimics to independent revolutes - see
       davinci_instrument.urdf's own header comments for why (wrist_yaw and
       gripper open/close are physically COUPLED results of jaw_1+jaw_2, not
       independently disk-driven; URDF's single-parent linear <mimic> can't
       express that coupling, so it's left unmodeled here rather than faked).
       world / world_to_PSM1_adaptor removed - PSM1_adaptor_link now attaches
       directly to carriage_link below.

       Mount transform measured from the combined Fusion assembly: user
       placed a reference copy of the housing geometry (labelled "Da Vinci
       Base (Large Needle Driver 420006)") at the real physical mount
       location on the carriage, deliberately positioned (confirmed by
       user). PSM1_adaptor_link's frame was then recovered the same way as
       the wrist mount - removing the known housing-mesh-to-adaptor-link
       offset from the reference occurrence's transform - then expressed
       relative to carriage_link. -->
  <joint name="carriage_to_davinci_mount" type="fixed">
    <parent link="carriage_link"/>
    <child link="PSM1_adaptor_link"/>
    <origin xyz="0.0 0.000005 0.01865" rpy="0.0 1.570796 0.0"/>
    <!-- xyz Y/Z measured directly in Fusion (Inspect > Measure) as the
         center of the two circular edges of the dovetail/Top Cage
         opening. Rotation confirmed correct by user - do not adjust
         pitch sign again without a real measurement. X still at 0 and
         still needs a real depth/translation value along the shaft
         axis - see open item in conversation. -->
  </joint>

  <link name="PSM1_adaptor_link"/>

  <joint name="PSM1_housing_fixed" type="fixed">
    <parent link="PSM1_adaptor_link"/>
    <child link="PSM1_housing_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
  </joint>
  <link name="PSM1_housing_link">
    <visual>
      <origin rpy="0.0 -1.5707963267948966 1.5707963267948966" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="assets/housing_Si.obj"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0.0 -1.5707963267948966 1.5707963267948966" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="assets/housing_Si.obj"/>
      </geometry>
    </collision>
  </link>

  <!-- z offset = 0.493606, derived from: mount-origin-to-dovetail-face
       (0.050406m, measured/trusted) + user-measured housing-emerge-to-
       jaw-tip length (46-46.5cm, midpoint 0.4625m used) - minus the fixed
       internal roll_link-to-tool_tip kinematic distance (0.0193m, computed
       from the untouched original dVRK joint offsets). Assumes the
       dovetail face is an adequate proxy for "where the shaft emerges
       from housing" - the two may differ slightly. -->
  <joint name="roll" type="revolute">
    <parent link="PSM1_adaptor_link"/>
    <child link="PSM1_roll_link"/>
    <axis xyz="0.0 0.0 1"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.493606"/>
    <limit effort="1000" lower="-4.53786" upper="4.53786" velocity=".4"/>
  </joint>
  <link name="PSM1_roll_link">
    <visual>
      <origin rpy="-1.5707963267948966 0.0 1.5707963267948966" xyz="0.0 0.0 0.02975"/>
      <geometry>
        <mesh filename="assets/roll_4670.obj" scale="0.1 0.1 0.1"/>
      </geometry>
      <material name="roll_4670_shaft">
        <color rgba="0.55 0.55 0.55 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="-1.5707963267948966 0.0 0.0" xyz="0.0 0.0 0.02975"/>
      <geometry>
        <mesh filename="assets/roll_4670.obj" scale="0.1 0.1 0.1"/>
      </geometry>
    </collision>
  </link>

  <joint name="wrist_pitch" type="revolute">
    <parent link="PSM1_roll_link"/>
    <child link="PSM1_wrist_pitch_link"/>
    <axis xyz="0.0 0.0 1"/>
    <origin rpy="-1.5707963267948966 -1.5707963267948966 0.0" xyz="0.0 0.0 0.0"/>
    <limit effort="1000" lower="-1.39626" upper="1.39626" velocity=".4"/>
  </joint>
  <link name="PSM1_wrist_pitch_link">
    <visual>
      <origin rpy="0.0 1.5707963267948966 1.5707963267948966" xyz="0.0295 0.0 0.0"/>
      <geometry>
        <mesh filename="assets/wrist_pitch_0091.obj" scale="0.1 0.1 0.1"/>
      </geometry>
    </visual>
  </link>

  <!-- wrist_yaw is NOT independently disk-driven - see file header. Fixed
       here at the nominal/neutral position. -->
  <joint name="wrist_yaw" type="fixed">
    <parent link="PSM1_wrist_pitch_link"/>
    <child link="PSM1_wrist_yaw_link"/>
    <origin rpy="-1.5707963267948966 -1.5707963267948966 0.0" xyz="0.0091 0.0 0.0"/>
  </joint>
  <link name="PSM1_wrist_yaw_link">
    <visual>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.000236"/>
      <geometry>
        <mesh filename="assets/wrist_yaw_0091.obj"/>
      </geometry>
    </visual>
  </link>

  <!-- jaw_1 and jaw_2: the two real disk-driven joints (disks 3 and 4). -->
  <joint name="jaw_1" type="revolute">
    <parent link="PSM1_wrist_yaw_link"/>
    <child link="PSM1_jaw_1_link"/>
    <axis xyz="0.0 0.0 1"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0 0.0"/>
    <limit effort="1000" lower="-1.5707" upper="1.5707" velocity=".4"/>
  </joint>
  <link name="PSM1_jaw_1_link">
    <visual>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="assets/tip_006_1.obj"/>
      </geometry>
    </visual>
  </link>

  <joint name="jaw_2" type="revolute">
    <parent link="PSM1_wrist_yaw_link"/>
    <child link="PSM1_jaw_2_link"/>
    <axis xyz="0.0 0.0 1"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    <limit effort="1000" lower="-1.5707" upper="1.5707" velocity=".4"/>
  </joint>
  <link name="PSM1_jaw_2_link">
    <visual>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="assets/tip_006_2.obj"/>
      </geometry>
    </visual>
  </link>

  <joint name="tool_tip" type="fixed">
    <parent link="PSM1_wrist_yaw_link"/>
    <child link="PSM1_tool_tip_link"/>
    <origin rpy="0.0 1.5707963267948966 1.5707963267948966" xyz="0.0 0.0102 0.0"/>
  </joint>
  <link name="PSM1_tool_tip_link"/>

</robot>
